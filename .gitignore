# ==============================================================================
# docV.ai .gitignore (Strict Security & Build Artifacts Filtering)
# ==============================================================================

# 1. Environment & API Keys (CRITICAL: NEVER COMMIT REAL KEYS)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.pem
*.key

# 2. Python Virtual Environment & Caches
.venv/
backend/.venv/
venv/
env/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# 3. Node & Next.js Build Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.vercel
*.tsbuildinfo
next-env.d.ts.bak

# 4. Local uploads, PDFs & runtime logs
*.pdf
backend/uploads/*
!backend/uploads/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. OS & Editor Cache
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
